  "editor.tokenColorCustomizations": {
    "textMateRules": [
      // Comments
      {
        "scope": ["comment", "punctuation.definition.comment"],
        "settings": {
          "foreground": "$$$MUTED$$$",
          "fontStyle": "italic"
        }
      },

      // Strings
      {
        "scope": ["string", "punctuation.definition.string"],
        "settings": {
          "foreground": "$$$ACCENT$$$"
        }
      },

      // Regular Expressions
      {
        "scope": "string.regexp",
        "settings": {
          "foreground": "$$$ACCENT$$$"
        }
      },

      // Escape Characters
      {
        "scope": "constant.character.escape",
        "settings": {
          "foreground": "$$$ACCENT$$$"
        }
      },

      // Numbers & Constants
      {
        "scope": [
          "constant.numeric",
          "variable.other.constant",
          "entity.name.constant",
          "constant.language.boolean",
          "constant.language.null",
          "constant.language.undefined"
        ],
        "settings": {
          "foreground": "$$$MUTED$$$"
        }
      },

      // Keywords
      {
        "scope": [
          "keyword",
          "keyword.control",
          "keyword.operator.word",
          "keyword.operator.new",
          "variable.language.super",
          "variable.language.this",
          "support.type.primitive",
          "storage.type",
          "storage.modifier"
        ],
        "settings": {
          "foreground": "$$$ACCENT$$$",
          "fontStyle": "bold"
        }
      },

      // Operators & Punctuation
      {
        "scope": [
          "keyword.operator",
          "punctuation.accessor",
          "punctuation.definition.generic",
          "punctuation.separator.key-value"
        ],
        "settings": {
          "foreground": "$$$MUTED$$$"
        }
      },

      // Punctuation (general)
      {
        "scope": "punctuation",
        "settings": {
          "foreground": "$$$MUTED$$$"
        }
      },

      // Python-specific punctuation (tuples, dicts, etc.)
      {
        "scope": [
          "punctuation.definition.tuple.begin.python",
          "punctuation.definition.tuple.end.python",
          "punctuation.definition.dict.begin.python",
          "punctuation.definition.dict.end.python",
          "punctuation.definition.list.begin.python",
          "punctuation.definition.list.end.python",
          "punctuation.definition.parameters.begin.python",
          "punctuation.definition.parameters.end.python"
        ],
        "settings": {
          "foreground": "$$$MUTED$$$"
        }
      },

      // General punctuation overrides
      {
        "scope": [
          "punctuation.parenthesis",
          "punctuation.bracket",
          "punctuation.brace"
        ],
        "settings": {
          "foreground": "$$$MUTED$$$"
        }
      },

      // Section headers (e.g., [Service] in systemd/ini files)
      {
        "scope": "punctuation.definition.section",
        "settings": {
          "foreground": "$$$MUTED$$$"
        }
      },

      // Functions
      {
        "scope": [
          "entity.name.function",
          "meta.function-call.method",
          "support.function",
          "variable.function"
        ],
        "settings": {
          "foreground": "$$$ACCENT$$$",
          "fontStyle": "italic"
        }
      },

      // Classes & Types
      {
        "scope": [
          "entity.name.class",
          "entity.other.inherited-class",
          "support.class",
          "meta.function-call.constructor",
          "entity.name.type",
          "meta.type",
          "support.type"
        ],
        "settings": {
          "foreground": "$$$ACCENT$$$",
          "fontStyle": "bold"
        }
      },

      // Enum
      {
        "scope": "entity.name.enum",
        "settings": {
          "foreground": "$$$ACCENT$$$",
          "fontStyle": "bold"
        }
      },

      // Enum Members & Object Properties
      {
        "scope": [
          "variable.other.enummember",
          "meta.property.object",
          "meta.object-literal.key"
        ],
        "settings": {
          "foreground": "$$$MUTED$$$"
        }
      },

      // Variables
      {
        "scope": [
          "variable",
          "variable.other.readwrite"
        ],
        "settings": {
          "foreground": "$$$FOREGROUND$$$"
        }
      },

      // Modules & Imports (package names)
      {
        "scope": [
          "entity.name.namespace",
          "entity.name.module",
          "support.type.module",
          "meta.import variable.other"
        ],
        "settings": {
          "foreground": "$$$ACCENT$$$"
        }
      },

      // Function Parameters
      {
        "scope": [
          "variable.parameter",
          "meta.function.parameters"
        ],
        "settings": {
          "foreground": "$$$MUTED$$$",
          "fontStyle": "italic"
        }
      },

      // Decorators & Annotations
      {
        "scope": [
          "meta.decorator",
          "punctuation.decorator",
          "meta.annotation"
        ],
        "settings": {
          "foreground": "$$$MUTED$$$",
          "fontStyle": "italic"
        }
      },

      // Built-in Constants
      {
        "scope": ["constant.language", "support.function.builtin"],
        "settings": {
          "foreground": "$$$ACCENT$$$",
          "fontStyle": "bold"
        }
      },

      // HTML/XML Tags
      {
        "scope": [
          "entity.name.tag",
          "punctuation.definition.tag"
        ],
        "settings": {
          "foreground": "$$$ACCENT$$$"
        }
      },

      // HTML/XML Attributes
      {
        "scope": [
          "entity.other.attribute-name"
        ],
        "settings": {
          "foreground": "$$$MUTED$$$",
          "fontStyle": "italic"
        }
      },

      // CSS Selectors
      {
        "scope": [
          "entity.name.tag.css",
          "entity.other.attribute-name.class.css",
          "entity.other.attribute-name.id.css"
        ],
        "settings": {
          "foreground": "$$$ACCENT$$$"
        }
      },

      // CSS Properties
      {
        "scope": "support.type.property-name.css",
        "settings": {
          "foreground": "$$$MUTED$$$"
        }
      },

      // JSON Keys
      {
        "scope": "support.type.property-name.json",
        "settings": {
          "foreground": "$$$ACCENT$$$"
        }
      },

      // Markdown Headings
      {
        "scope": [
          "markup.heading",
          "entity.name.section.markdown"
        ],
        "settings": {
          "foreground": "$$$DANGER$$$",
          "fontStyle": "bold"
        }
      },

      // Markdown Bold
      {
        "scope": "markup.bold",
        "settings": {
          "foreground": "$$$ACCENT$$$",
          "fontStyle": "bold"
        }
      },

      // Markdown Italic
      {
        "scope": "markup.italic",
        "settings": {
          "foreground": "$$$ACCENT$$$",
          "fontStyle": "italic"
        }
      },

      // Markdown Code
      {
        "scope": ["markup.inline.raw", "markup.fenced_code"],
        "settings": {
          "foreground": "$$$ACCENT$$$"
        }
      },

      // Markdown Links
      {
        "scope": [
          "markup.underline.link",
          "string.other.link.title.markdown"
        ],
        "settings": {
          "foreground": "$$$ACCENT$$$"
        }
      },

      // Invalid/Error
      {
        "scope": "invalid",
        "settings": {
          "foreground": "$$$BACKGROUND$$$",
          "background": "$$$DANGER$$$"
        }
      },

      // Deprecated
      {
        "scope": "invalid.deprecated",
        "settings": {
          "foreground": "$$$BACKGROUND$$$",
          "background": "$$$MUTED$$$"
        }
      }
    ]
  },

  // Font settings
  "editor.fontFamily": "$$$FONT$$$",
  "editor.fontSize": 15,
  "terminal.integrated.fontFamily": "$$$FONT$$$",
  "terminal.integrated.fontSize": $$$FONT_SIZE$$$,
  "editor.semanticHighlighting.enabled": false,
  "editor.language.colorizedBracketPairs": false
}
