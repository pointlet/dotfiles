  "editor.tokenColorCustomizations": {
    "textMateRules": [
      // Comments
      {
        "scope": ["comment", "punctuation.definition.comment"],
        "settings": {
          "foreground": "#8d8c84",
          "fontStyle": "italic"
        }
      },

      // Strings
      {
        "scope": ["string", "punctuation.definition.string"],
        "settings": {
          "foreground": "#596369"
        }
      },

      // Regular Expressions
      {
        "scope": "string.regexp",
        "settings": {
          "foreground": "#596369"
        }
      },

      // Escape Characters
      {
        "scope": "constant.character.escape",
        "settings": {
          "foreground": "#596369"
        }
      },

      // Numbers & Constants
      {
        "scope": [
          "constant.numeric",
          "variable.other.constant",
          "entity.name.constant",
          "constant.language.boolean",
          "constant.language.null",
          "constant.language.undefined"
        ],
        "settings": {
          "foreground": "#8d8c84"
        }
      },

      // Keywords
      {
        "scope": [
          "keyword",
          "keyword.control",
          "keyword.operator.word",
          "keyword.operator.new",
          "variable.language.super",
          "variable.language.this",
          "support.type.primitive",
          "storage.type",
          "storage.modifier"
        ],
        "settings": {
          "foreground": "#596369",
          "fontStyle": "bold"
        }
      },

      // Operators & Punctuation
      {
        "scope": [
          "keyword.operator",
          "punctuation.accessor",
          "punctuation.definition.generic",
          "punctuation.separator.key-value"
        ],
        "settings": {
          "foreground": "#8d8c84"
        }
      },

      // Punctuation (general)
      {
        "scope": "punctuation",
        "settings": {
          "foreground": "#8d8c84"
        }
      },

      // Python-specific punctuation (tuples, dicts, etc.)
      {
        "scope": [
          "punctuation.definition.tuple.begin.python",
          "punctuation.definition.tuple.end.python",
          "punctuation.definition.dict.begin.python",
          "punctuation.definition.dict.end.python",
          "punctuation.definition.list.begin.python",
          "punctuation.definition.list.end.python",
          "punctuation.definition.parameters.begin.python",
          "punctuation.definition.parameters.end.python"
        ],
        "settings": {
          "foreground": "#8d8c84"
        }
      },

      // General punctuation overrides
      {
        "scope": [
          "punctuation.parenthesis",
          "punctuation.bracket",
          "punctuation.brace"
        ],
        "settings": {
          "foreground": "#8d8c84"
        }
      },

      // Section headers (e.g., [Service] in systemd/ini files)
      {
        "scope": "punctuation.definition.section",
        "settings": {
          "foreground": "#8d8c84"
        }
      },

      // Functions
      {
        "scope": [
          "entity.name.function",
          "meta.function-call.method",
          "support.function",
          "variable.function"
        ],
        "settings": {
          "foreground": "#596369",
          "fontStyle": "italic"
        }
      },

      // Classes & Types
      {
        "scope": [
          "entity.name.class",
          "entity.other.inherited-class",
          "support.class",
          "meta.function-call.constructor",
          "entity.name.type",
          "meta.type",
          "support.type"
        ],
        "settings": {
          "foreground": "#596369",
          "fontStyle": "bold"
        }
      },

      // Enum
      {
        "scope": "entity.name.enum",
        "settings": {
          "foreground": "#596369",
          "fontStyle": "bold"
        }
      },

      // Enum Members & Object Properties
      {
        "scope": [
          "variable.other.enummember",
          "meta.property.object",
          "meta.object-literal.key"
        ],
        "settings": {
          "foreground": "#8d8c84"
        }
      },

      // Variables
      {
        "scope": [
          "variable",
          "variable.other.readwrite"
        ],
        "settings": {
          "foreground": "#3b3936"
        }
      },

      // Modules & Imports (package names)
      {
        "scope": [
          "entity.name.namespace",
          "entity.name.module",
          "support.type.module",
          "meta.import variable.other"
        ],
        "settings": {
          "foreground": "#596369"
        }
      },

      // Function Parameters
      {
        "scope": [
          "variable.parameter",
          "meta.function.parameters"
        ],
        "settings": {
          "foreground": "#8d8c84",
          "fontStyle": "italic"
        }
      },

      // Decorators & Annotations
      {
        "scope": [
          "meta.decorator",
          "punctuation.decorator",
          "meta.annotation"
        ],
        "settings": {
          "foreground": "#8d8c84",
          "fontStyle": "italic"
        }
      },

      // Built-in Constants
      {
        "scope": ["constant.language", "support.function.builtin"],
        "settings": {
          "foreground": "#596369",
          "fontStyle": "bold"
        }
      },

      // HTML/XML Tags
      {
        "scope": [
          "entity.name.tag",
          "punctuation.definition.tag"
        ],
        "settings": {
          "foreground": "#596369"
        }
      },

      // HTML/XML Attributes
      {
        "scope": [
          "entity.other.attribute-name"
        ],
        "settings": {
          "foreground": "#8d8c84",
          "fontStyle": "italic"
        }
      },

      // CSS Selectors
      {
        "scope": [
          "entity.name.tag.css",
          "entity.other.attribute-name.class.css",
          "entity.other.attribute-name.id.css"
        ],
        "settings": {
          "foreground": "#596369"
        }
      },

      // CSS Properties
      {
        "scope": "support.type.property-name.css",
        "settings": {
          "foreground": "#8d8c84"
        }
      },

      // JSON Keys
      {
        "scope": "support.type.property-name.json",
        "settings": {
          "foreground": "#596369"
        }
      },

      // Markdown Headings
      {
        "scope": [
          "markup.heading",
          "entity.name.section.markdown"
        ],
        "settings": {
          "foreground": "#d13b3b",
          "fontStyle": "bold"
        }
      },

      // Markdown Bold
      {
        "scope": "markup.bold",
        "settings": {
          "foreground": "#596369",
          "fontStyle": "bold"
        }
      },

      // Markdown Italic
      {
        "scope": "markup.italic",
        "settings": {
          "foreground": "#596369",
          "fontStyle": "italic"
        }
      },

      // Markdown Code
      {
        "scope": ["markup.inline.raw", "markup.fenced_code"],
        "settings": {
          "foreground": "#596369"
        }
      },

      // Markdown Links
      {
        "scope": [
          "markup.underline.link",
          "string.other.link.title.markdown"
        ],
        "settings": {
          "foreground": "#596369"
        }
      },

      // Invalid/Error
      {
        "scope": "invalid",
        "settings": {
          "foreground": "#e6e2e1",
          "background": "#d13b3b"
        }
      },

      // Deprecated
      {
        "scope": "invalid.deprecated",
        "settings": {
          "foreground": "#e6e2e1",
          "background": "#8d8c84"
        }
      }
    ]
  },

  // Font settings
  "editor.fontFamily": "IBM Plex Mono SemiBold",
  "editor.fontSize": 15,
  "terminal.integrated.fontFamily": "IBM Plex Mono SemiBold",
  "terminal.integrated.fontSize": 14,
  "editor.semanticHighlighting.enabled": false,
  "editor.language.colorizedBracketPairs": false
}
